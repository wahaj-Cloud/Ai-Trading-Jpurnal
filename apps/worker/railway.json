{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@atc/worker",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "pnpm-lock.yaml",
      "package.json",
      "pnpm-workspace.yaml",
      "turbo.json",
      ".nvmrc"
    ]
  },
  "deploy": {
    "startCommand": "node apps/worker/dist/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 60
  }
}
