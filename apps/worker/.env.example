# Copy to apps/worker/.env for local development. Never commit real values.
NODE_ENV=development
# Same Neon "pooled" connection string as the API
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Railway Redis (Variables -> reference the Redis service's REDIS_URL)
REDIS_URL=redis://default:PASSWORD@HOST:PORT
# Must be IDENTICAL to the API's values: the worker decrypts what the API encrypted.
CREDENTIAL_KEYS=v1:replace-with-the-same-value-as-the-api
CREDENTIAL_ACTIVE_KEY_ID=v1
# Optional tuning
SYNC_INTERVAL_MINUTES=5
SYNC_CONCURRENCY=4
# AI coach (optional: without a key, AI features are off and rules-based insights still work)
ANTHROPIC_API_KEY=
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_SMART_MODEL=claude-sonnet-5
AI_CONCURRENCY=2
# Email notifications (optional: without a key, notifications are in-app only)
RESEND_API_KEY=
EMAIL_FROM=AI Trading Coach <coach@yourdomain.com>
APP_URL=https://app.yourdomain.com
# Production: store master keys encrypted with AWS KMS instead of CREDENTIAL_KEYS
# (see docs/launch-hardening.md). Needs AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
# CREDENTIAL_KEYS_KMS=v1:<base64 ciphertext>
# Error monitoring (optional): sentry.io project DSN
SENTRY_DSN=
# MetaTrader brokers (Exness) through MetaApi (metaapi.cloud). Without it, Exness accounts wait.
METAAPI_TOKEN=
