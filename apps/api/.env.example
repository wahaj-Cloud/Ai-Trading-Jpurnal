# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
# Neon "pooled" connection string (host contains -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Railway Redis (job queue shared with the worker)
REDIS_URL=redis://localhost:6379
# Clerk dashboard > API keys > Secret key
CLERK_SECRET_KEY=sk_test_xxx
# Clerk dashboard > Webhooks > your endpoint > Signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
# Exact web app address(es), comma-separated, no trailing slash
WEB_ORIGINS=http://localhost:3000
# Master key(s) for exchange credentials: v1:<64 random letters/numbers>. Back it up!
CREDENTIAL_KEYS=v1:replace-with-64-random-letters-and-numbers-from-your-password-manager
CREDENTIAL_ACTIVE_KEY_ID=v1
# Static outbound IPs users whitelist on exchanges (comma-separated). Optional.
EXCHANGE_EGRESS_IPS=
# Exchange base-URL overrides for testnets only (e.g. BingX demo: https://open-api-vst.bingx.com). Leave unset in production.
# BINGX_BASE_URL=
# AI coach (optional). Same values as the worker.
ANTHROPIC_API_KEY=
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_SMART_MODEL=claude-sonnet-5
# Billing (paddle.com). Leave empty until you set up Paddle; admins can still grant plans.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
# PLAN:month|year:price_id, comma-separated
PADDLE_PRICES=
# Emails that get the admin panel (comma-separated, must be the sign-in email)
ADMIN_EMAILS=
# Production: store master keys encrypted with AWS KMS instead of CREDENTIAL_KEYS
# (see docs/launch-hardening.md). Needs AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
# CREDENTIAL_KEYS_KMS=v1:<base64 ciphertext>
# Error monitoring (optional): sentry.io project DSN
SENTRY_DSN=
# Let users connect MetaTrader brokers (Exness). Set to true once the worker has METAAPI_TOKEN.
EXNESS_ENABLED=false
