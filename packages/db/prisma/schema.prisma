// AI Trading Coach — Phase 2 schema (identity, billing foundation, audit).
// Trading tables are added in the phase that introduces them (see docs/roadmap.md).

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PlanCode {
  FREE
  PRO
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  authProviderId String    @unique @map("auth_provider_id")
  email          String    @unique
  name           String?
  imageUrl       String?   @map("image_url")
  timezone       String    @default("UTC")
  baseCurrency   String    @default("USDT") @map("base_currency")
  /// ISO code amounts are shown in; stored values stay in USD and are converted for display.
  displayCurrency String   @default("USD") @map("display_currency")
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Account deleted at the identity provider: personal data scrubbed, exchange keys destroyed.
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Blocked by an admin (reversible). Sign-in, sync, AI and notifications stop.
  suspendedAt    DateTime? @map("suspended_at") @db.Timestamptz(3)
  /// The primary email is verified at the identity provider (required for admin access).
  emailVerified  Boolean   @default(false) @map("email_verified")
  /// Identity provider's last-modified time of the profile we stored: older webhook events are ignored.
  providerUpdatedAt DateTime? @map("provider_updated_at") @db.Timestamptz(3)
  /// Early supporter (founding-member offer); shown as a badge.
  foundingMember Boolean   @default(false) @map("founding_member")

  settings         UserSettings?
  subscription     Subscription?
  usageCounters    UsageCounter[]
  auditLogs        AuditLog[]
  exchangeAccounts ExchangeAccount[]
  positions        Position[]
  openPositions    OpenPosition[]
  journalEntries   JournalEntry[]
  tradeReviews     TradeReview[]
  tradeContexts    TradeContext[]
  coachNotes       CoachNote[]
  cryptoPayments   CryptoPayment[]
  conversations    CoachConversation[]
  riskLimit        RiskLimit?
  goals            Goal[]
  notifications    Notification[]
  setups           Setup[]
  setupAlerts      SetupAlert[]
  scalpAlerts      ScalpAlert[]
  zoneAlerts       ZoneAlert[]
  paperBots        PaperBot[]
  whatIfScenarios  WhatIfScenario[]
  backtestRuns     BacktestRun[]

  @@index([deletedAt])
  @@map("users")
}

model UserSettings {
  userId              String   @id @map("user_id") @db.Uuid
  theme               String   @default("dark")
  pnlColorScheme      String   @default("standard") @map("pnl_color_scheme") // standard | colorblind
  notificationPrefs   Json     @default("{}") @map("notification_prefs")
  defaultRiskPerTrade Decimal? @map("default_risk_per_trade") @db.Decimal(10, 4)
  /// Dashboard widget order and visibility: [{ id, hidden }]. Null means the default layout.
  dashboardLayout     Json?    @map("dashboard_layout")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Plan {
  code          PlanCode @id
  name          String
  limits        Json // { exchangeAccounts, aiReviewsPerMonth, historyDays, coachMessagesPerDay }
  paddlePriceId String?  @unique @map("paddle_price_id")
  /// Monthly list price (US$), used for the admin margin view. Billing amounts come from Paddle.
  priceUsd      Decimal? @map("price_usd") @db.Decimal(10, 2)
  isPublic      Boolean  @default(true) @map("is_public")
  sortOrder     Int      @default(0) @map("sort_order")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid(7)) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  planCode             PlanCode           @default(FREE) @map("plan_code")
  status               SubscriptionStatus @default(ACTIVE)
  paddleSubscriptionId String?            @unique @map("paddle_subscription_id")
  paddleCustomerId     String?            @map("paddle_customer_id")
  currentPeriodEnd     DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  /// Paddle price the subscription is on (maps to plan and interval via configuration).
  paddlePriceId        String?            @map("paddle_price_id")
  /// occurred_at of the last applied Paddle event: older events arriving late are ignored.
  paddleEventAt        DateTime?          @map("paddle_event_at") @db.Timestamptz(3)
  /// Set by an admin: the plan was granted manually and billing events must not override it.
  manualPlan           Boolean            @default(false) @map("manual_plan")
  /// Paid with crypto (no auto-renewal): the plan lapses to Free after this time.
  cryptoPaidUntil      DateTime?          @map("crypto_paid_until") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planCode], references: [code])

  @@index([status])
  @@index([paddleCustomerId])
  @@map("subscriptions")
}

model UsageCounter {
  userId String @map("user_id") @db.Uuid
  metric String // e.g. ai_trade_review, coach_message
  period String // e.g. 2026-09 (monthly) or 2026-09-26 (daily)
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, metric, period])
  @@map("usage_counters")
}

enum Exchange {
  BINANCE
  MEXC
  KUCOIN
  BINGX
  EXNESS // MetaTrader broker, synced through MetaApi
  BYBIT
  OKX
}

enum ExchangeAccountStatus {
  ACTIVE // verified and usable for sync
  INVALID // exchange now rejects the key (revoked, expired, permissions changed)
  DISCONNECTED // user removed the key; history is kept
  CONNECTING // MetaTrader account being logged in (provisioned at MetaApi); not usable yet
}

model ExchangeAccount {
  id                  String                @id @default(uuid(7)) @db.Uuid
  userId              String                @map("user_id") @db.Uuid
  exchange            Exchange
  label               String
  status              ExchangeAccountStatus @default(ACTIVE)
  /// The exchange's own account ID (e.g. Binance UID). Guards against a reconnect switching accounts.
  externalAccountId   String?               @map("external_account_id")
  /// Last 4 characters of the API key, for display only.
  apiKeyHint          String                @map("api_key_hint")
  /// null when the exchange does not report IP restrictions.
  ipRestricted        Boolean?              @map("ip_restricted")
  /// Permission flags reported by the exchange at the last verification.
  permissions         Json                  @default("{}")
  /// Non-secret connection details: MetaTrader server and platform, MetaApi account id and
  /// provisioning state. Never holds passwords or keys.
  metadata            Json                  @default("{}")
  /// When the exchange will expire this key (MEXC keys without an IP whitelist).
  keyExpiresAt        DateTime?             @map("key_expires_at") @db.Timestamptz(3)
  lastVerifiedAt      DateTime?             @map("last_verified_at") @db.Timestamptz(3)
  lastError           String?               @map("last_error")
  /// End of the most recent successful sync window.
  lastSyncedAt        DateTime?             @map("last_synced_at") @db.Timestamptz(3)
  /// Earliest point of downloaded history (exchanges keep ~3 months).
  historyStartsAt     DateTime?             @map("history_starts_at") @db.Timestamptz(3)
  /// Set once the initial history download has finished.
  backfillCompletedAt DateTime?             @map("backfill_completed_at") @db.Timestamptz(3)
  /// Consecutive failed syncs; drives the retry backoff. Reset on success.
  syncFailures        Int                   @default(0) @map("sync_failures")
  /// When a failing account may be tried again (null = no backoff in effect).
  syncRetryAt         DateTime?             @map("sync_retry_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential        ExchangeCredential?
  fills             Fill[]
  incomeEvents      IncomeEvent[]
  exchangePositions ExchangePosition[]
  positions         Position[]
  syncCursors       SyncCursor[]
  syncRuns          SyncRun[]
  openPositions     OpenPosition[]
  journalEntries    JournalEntry[]
  tradeReviews      TradeReview[]
  tradeContexts     TradeContext[]

  @@unique([userId, exchange, externalAccountId])
  @@index([userId, status])
  @@index([status, lastSyncedAt])
  @@map("exchange_accounts")
}

/// Secrets live in their own table so no ordinary query can select them by accident.
/// Envelope-encrypted: fields use a per-record data key, wrapped by master key `keyId`.
model ExchangeCredential {
  accountId        String    @id @map("account_id") @db.Uuid
  keyId            String    @map("key_id")
  wrappedDataKey   Bytes     @map("wrapped_data_key")
  apiKeyCipher     Bytes     @map("api_key_cipher")
  apiSecretCipher  Bytes     @map("api_secret_cipher")
  passphraseCipher Bytes?    @map("passphrase_cipher") // OKX/KuCoin-style exchanges
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)

  account ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([keyId])
  @@map("exchange_credentials")
}

// ─── Sync: raw exchange data (stored as received; everything below it is rebuildable) ───

enum TradeSide {
  BUY
  SELL
}

enum PositionSide {
  LONG
  SHORT
  BOTH
}

enum IncomeType {
  FUNDING
  COMMISSION
  REALIZED_PNL
  OTHER
}

/// One execution. Quantity in base units (contracts x contract size); fee in quote, positive = paid.
model Fill {
  id             String       @id @default(uuid(7)) @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  exchangeFillId String       @map("exchange_fill_id")
  orderId        String?      @map("order_id")
  symbol         String
  side           TradeSide
  positionSide   PositionSide @map("position_side")
  price          Decimal      @db.Decimal(36, 18)
  qty            Decimal      @db.Decimal(36, 18)
  fee            Decimal      @db.Decimal(36, 18)
  feeAsset       String?      @map("fee_asset")
  realizedPnl    Decimal?     @map("realized_pnl") @db.Decimal(36, 18)
  isMaker        Boolean?     @map("is_maker")
  executedAt     DateTime     @map("executed_at") @db.Timestamptz(3)
  raw            Json
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  account   ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  positions PositionFill[]

  @@unique([accountId, exchangeFillId])
  @@index([accountId, symbol, executedAt])
  @@map("fills")
}

/// Account ledger entries: funding, commissions, realised PnL. Amount signed: positive = received.
model IncomeEvent {
  id         String     @id @default(uuid(7)) @db.Uuid
  accountId  String     @map("account_id") @db.Uuid
  externalId String     @map("external_id")
  type       IncomeType
  amount     Decimal    @db.Decimal(36, 18)
  asset      String
  symbol     String?
  occurredAt DateTime   @map("occurred_at") @db.Timestamptz(3)
  raw        Json
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  account ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([accountId, type, occurredAt])
  @@map("income_events")
}

/// A position record as the exchange computed it (MEXC, KuCoin, BingX). Refreshed while it changes.
model ExchangePosition {
  id         String    @id @default(uuid(7)) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  externalId String    @map("external_id")
  symbol     String
  closed     Boolean
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(3)
  raw        Json
  fetchedAt  DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)

  account ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@map("exchange_positions")
}

// ─── Sync: derived journal data (rebuilt from raw data; never edited by hand) ───

enum PositionSource {
  FILLS // rebuilt by our engine from fills (Binance)
  EXCHANGE // computed by the exchange (MEXC, KuCoin, BingX)
  CSV // imported by the user
}

enum PositionDirection {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum FillRole {
  OPEN
  CLOSE
}

/// A journal "trade": one round trip on one symbol and direction.
model Position {
  id                String            @id @default(uuid(7)) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  /// null for CSV imports that are not tied to a connected account.
  accountId         String?           @map("account_id") @db.Uuid
  exchange          Exchange
  source            PositionSource
  /// Stable identity within the user's journal, so re-syncs update rows instead of duplicating.
  sourceKey         String            @map("source_key")
  symbol            String
  baseAsset         String            @map("base_asset")
  quoteAsset        String            @map("quote_asset")
  /// Currency the PnL, fees and funding are paid in: the quote for linear (USDT/USDC) contracts,
  /// the base coin for inverse (coin-margined, "USD"-quoted) contracts.
  settleAsset       String            @map("settle_asset")
  direction         PositionDirection
  status            PositionStatus
  openedAt          DateTime          @map("opened_at") @db.Timestamptz(3)
  closedAt          DateTime?         @map("closed_at") @db.Timestamptz(3)
  entryPrice        Decimal?          @map("entry_price") @db.Decimal(36, 18)
  exitPrice         Decimal?          @map("exit_price") @db.Decimal(36, 18)
  quantity          Decimal?          @db.Decimal(36, 18)
  /// MetaTrader (Exness) size in lots, as the broker shows it; null for crypto exchanges.
  lots              Decimal?          @db.Decimal(20, 4)
  leverage          Decimal?          @db.Decimal(10, 2)
  grossPnl          Decimal?          @map("gross_pnl") @db.Decimal(36, 18)
  fees              Decimal?          @db.Decimal(36, 18)
  funding           Decimal?          @db.Decimal(36, 18)
  netPnl            Decimal?          @map("net_pnl") @db.Decimal(36, 18)
  holdingSeconds    Int?              @map("holding_seconds")
  /// The position opened before the history we could download.
  incompleteHistory Boolean           @default(false) @map("incomplete_history")
  /// The setup alert this trade followed ("planned"), matched after sync.
  setupAlertId      String?           @map("setup_alert_id") @db.Uuid
  /// How closely the coin moved with BTC (24h) when the trade opened (Market Pulse).
  btcCorrAtEntry    Float?            @map("btc_corr_at_entry") @db.Real
  /// Scalp Cockpit readings counted at entry: { at, tf5: {up, down, total}, tf15: {...} }, or
  /// { none: true } when the market was not scanned then.
  entryReadout      Json?             @map("entry_readout")
  /// 1H and 4H supply/demand zones the entry price was inside: { at, zones: [{ tf, side, fresh }] },
  /// or { none: true } when the market had no zone record then.
  entryZone         Json?             @map("entry_zone")
  btcBetaAtEntry    Float?            @map("btc_beta_at_entry") @db.Real
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    ExchangeAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  setupAlert SetupAlert?      @relation(fields: [setupAlertId], references: [id], onDelete: SetNull)
  fills      PositionFill[]

  @@unique([userId, sourceKey])
  @@index([userId, closedAt(sort: Desc)])
  @@index([userId, status])
  @@index([accountId, symbol])
  /// Global "recently closed" scans by the schedulers.
  @@index([closedAt])
  @@map("positions")
}

enum MarginMode {
  CROSS
  ISOLATED
}

/// Live open position as reported by the exchange at the last sync (replaced on every sync).
/// Separate from journal positions: it carries mark price and unrealised PnL, which change constantly.
model OpenPosition {
  id               String            @id @default(uuid(7)) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  accountId        String            @map("account_id") @db.Uuid
  exchange         Exchange
  /// Exchange position ID, or symbol:side when the exchange has none.
  externalId       String            @map("external_id")
  symbol           String
  baseAsset        String            @map("base_asset")
  quoteAsset       String            @map("quote_asset")
  settleAsset      String            @map("settle_asset")
  direction        PositionDirection
  /// Base units for linear contracts; quote (USD) units for inverse contracts. Null when the
  /// exchange reports contracts and the contract size is unknown.
  quantity         Decimal?          @db.Decimal(36, 18)
  /// MetaTrader (Exness) size in lots; null for crypto exchanges.
  lots             Decimal?          @db.Decimal(20, 4)
  entryPrice       Decimal?          @map("entry_price") @db.Decimal(36, 18)
  markPrice        Decimal?          @map("mark_price") @db.Decimal(36, 18)
  unrealizedPnl    Decimal?          @map("unrealized_pnl") @db.Decimal(36, 18)
  leverage         Decimal?          @db.Decimal(10, 2)
  liquidationPrice Decimal?          @map("liquidation_price") @db.Decimal(36, 18)
  marginMode       MarginMode?       @map("margin_mode")
  openedAt         DateTime?         @map("opened_at") @db.Timestamptz(3)
  syncedAt         DateTime          @map("synced_at") @db.Timestamptz(3)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([userId])
  @@map("open_positions")
}

// ─── Journal: the trader's own notes (never touched by sync) ───

/// The trader's review of one trade. Linked by the position's source key rather than a foreign key,
/// because a rebuild may delete and later recreate a position; the notes must survive that.
model JournalEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Removing an exchange account removes its notes; null for CSV-imported trades.
  accountId      String?  @map("account_id") @db.Uuid
  /// positions.source_key of the trade this entry reviews.
  positionKey    String   @map("position_key")
  setup          String?  @db.VarChar(80)
  tags           String[] @default([])
  /// Codes from the shared emotion list (e.g. FOMO, REVENGE).
  emotions       String[] @default([])
  /// Codes from the shared mistake list (e.g. MOVED_STOP, NO_PLAN).
  mistakes       String[] @default([])
  /// 1 (poor execution) to 5 (textbook).
  rating         Int?     @db.SmallInt
  notes          String?
  /// Planned stop and target: make risk (R) measurable.
  stopPrice      Decimal? @map("stop_price") @db.Decimal(36, 18)
  targetPrice    Decimal? @map("target_price") @db.Decimal(36, 18)
  /// Chart screenshot links (uploads arrive in a later phase).
  screenshotUrls String[] @default([]) @map("screenshot_urls")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account ExchangeAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, positionKey])
  @@index([tags], type: Gin)
  @@index([accountId])
  @@map("journal_entries")
}

/// Which part of which fill belongs to a position (a flip splits one fill between two positions).
model PositionFill {
  positionId String   @map("position_id") @db.Uuid
  fillId     String   @map("fill_id") @db.Uuid
  qty        Decimal  @db.Decimal(36, 18)
  role       FillRole

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  fill     Fill     @relation(fields: [fillId], references: [id], onDelete: Cascade)

  @@id([positionId, fillId])
  @@index([fillId])
  @@map("position_fills")
}

// ─── Sync: bookkeeping ───

/// Resume points per data stream (e.g. "binance:fills:BTCUSDT"), so syncs continue where they stopped.
model SyncCursor {
  accountId String   @map("account_id") @db.Uuid
  stream    String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, stream])
  @@map("sync_cursors")
}

enum SyncRunKind {
  BACKFILL
  INCREMENTAL
  MANUAL
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model SyncRun {
  id                String        @id @default(uuid(7)) @db.Uuid
  accountId         String        @map("account_id") @db.Uuid
  kind              SyncRunKind
  status            SyncRunStatus @default(RUNNING)
  windowStart       DateTime?     @map("window_start") @db.Timestamptz(3)
  windowEnd         DateTime?     @map("window_end") @db.Timestamptz(3)
  fillsFetched      Int           @default(0) @map("fills_fetched")
  incomeFetched     Int           @default(0) @map("income_fetched")
  positionsUpserted Int           @default(0) @map("positions_upserted")
  errorCode         String?       @map("error_code")
  errorMessage      String?       @map("error_message")
  startedAt         DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?     @map("finished_at") @db.Timestamptz(3)

  account ExchangeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, startedAt(sort: Desc)])
  @@index([status, startedAt])
  @@map("sync_runs")
}

// Append-only. Never update or delete rows from application code.
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  ip        String?
  userAgent String?  @map("user_agent")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─── AI coach (Phase 6) ───

enum ReviewStatus {
  PENDING
  DONE
  FAILED
  LIMIT_REACHED
}

/// AI review of one trade. Keyed like journal entries (by the trade's stable source key) so it
/// survives rebuilds. The grade and flags are computed by rules; the texts are written by the model.
model TradeReview {
  id               String       @id @default(uuid(7)) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  accountId        String?      @map("account_id") @db.Uuid
  positionKey      String       @map("position_key")
  status           ReviewStatus @default(PENDING)
  grade            String       @db.VarChar(2)
  score            Int          @db.SmallInt
  gradeFactors     Json         @default("[]") @map("grade_factors")
  flags            Json         @default("[]")
  summary          String?
  entryAnalysis    String?      @map("entry_analysis")
  exitAnalysis     String?      @map("exit_analysis")
  riskAnalysis     String?      @map("risk_analysis")
  strategyAnalysis String?      @map("strategy_analysis")
  mistakes         String[]     @default([])
  positives        String[]     @default([])
  nextTime         String?      @map("next_time")
  /// Fingerprint of the trade and journal the review was written from (detects stale reviews).
  inputHash        String       @map("input_hash")
  model            String?
  promptVersion    String?      @map("prompt_version")
  inputTokens      Int          @default(0) @map("input_tokens")
  outputTokens     Int          @default(0) @map("output_tokens")
  error            String?
  generatedAt      DateTime?    @map("generated_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account ExchangeAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, positionKey])
  @@index([userId, generatedAt(sort: Desc)])
  @@index([accountId])
  @@map("trade_reviews")
}

enum CoachNoteKind {
  DAILY
  WEEKLY
}

/// End-of-day / end-of-week coaching note.
model CoachNote {
  id            String        @id @default(uuid(7)) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  kind          CoachNoteKind
  /// First day of the period, YYYY-MM-DD in the trader's timezone.
  period        String        @db.VarChar(10)
  /// { headline, wentWell[], costMoney[], focus }
  content       Json
  flags         Json          @default("[]")
  /// { trades, netPnl, winRate }
  stats         Json
  model         String?
  promptVersion String?       @map("prompt_version")
  inputTokens   Int           @default(0) @map("input_tokens")
  outputTokens  Int           @default(0) @map("output_tokens")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, period])
  @@index([userId, createdAt(sort: Desc)])
  @@map("coach_notes")
}

model CoachConversation {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("coach_conversations")
}

enum CoachRole {
  USER
  ASSISTANT
}

model CoachMessage {
  id             String    @id @default(uuid(7)) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  role           CoachRole
  content        String
  model          String?
  inputTokens    Int       @default(0) @map("input_tokens")
  outputTokens   Int       @default(0) @map("output_tokens")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("coach_messages")
}

// ─── Strategy analysis (Phase 7) ───

enum ContextStatus {
  DONE
  /// Not enough market history, or the exchange no longer lists the symbol. Not retried automatically.
  UNAVAILABLE
}

/// Market context of one trade (indicators, structure, zones, excursion), computed from candles.
model TradeContext {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  accountId   String?       @map("account_id") @db.Uuid
  positionKey String        @map("position_key")
  status      ContextStatus
  timeframe   String?       @db.VarChar(4)
  /// TradeContextDto
  context     Json?
  version     Int           @default(1) @db.SmallInt
  error       String?
  computedAt  DateTime      @default(now()) @map("computed_at") @db.Timestamptz(3)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account ExchangeAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, positionKey])
  @@index([accountId])
  @@map("trade_contexts")
}

// ─── Goals, risk limits, notifications (Phase 8) ───

/// Daily guard-rails, in USD. Null = no limit.
model RiskLimit {
  userId            String   @id @map("user_id") @db.Uuid
  maxDailyLoss      Decimal? @map("max_daily_loss") @db.Decimal(14, 2)
  maxTradesPerDay   Int?     @map("max_trades_per_day")
  maxDrawdown       Decimal? @map("max_drawdown") @db.Decimal(14, 2)
  dailyProfitTarget Decimal? @map("daily_profit_target") @db.Decimal(14, 2)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("risk_limits")
}

enum GoalPeriod {
  WEEK
  MONTH
}

/// A recurring goal, evaluated for every week or month.
model Goal {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  period    GoalPeriod
  metric    String     @db.VarChar(20)
  target    Decimal    @db.Decimal(14, 2)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

enum EmailStatus {
  NONE
  PENDING
  SENT
  FAILED
}

model Notification {
  id            String      @id @default(uuid(7)) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  kind          String      @db.VarChar(20)
  title         String      @db.VarChar(160)
  body          String
  link          String?
  /// Makes each event notify once (e.g. "risk:MAX_DAILY_LOSS:2026-09-27").
  dedupeKey     String      @map("dedupe_key")
  readAt        DateTime?   @map("read_at") @db.Timestamptz(3)
  emailStatus   EmailStatus @default(NONE) @map("email_status")
  emailAttempts Int         @default(0) @map("email_attempts") @db.SmallInt
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([emailStatus, createdAt])
  @@map("notifications")
}

// ─── Billing and admin (Phase 10) ───

/// Every billing webhook received, once (idempotency and audit).
/// A whale trade: one large market (taker) order on a public futures feed, fills added up.
model WhaleTrade {
  id       BigInt   @id @default(autoincrement())
  exchange Exchange
  symbol   String   @db.VarChar(20)
  /// Taker side: buy | sell
  side     String   @db.VarChar(4)
  price    Decimal  @db.Decimal(24, 10)
  qty      Decimal  @db.Decimal(30, 10)
  usd      Decimal  @db.Decimal(20, 2)
  fills    Int
  at       DateTime @db.Timestamptz(3)

  @@index([symbol, at(sort: Desc)])
  @@index([at])
  @@map("whale_trades")
}

/// Trend bias after each closed candle (Trade Check "your record"): which trend a past trade was
/// entered in. `at` is the candle's close time. Kept ~400 days.
model MarketTrendHistory {
  symbol    String   @db.VarChar(20)
  /// 1d | 4h
  timeframe String   @db.VarChar(4)
  at        DateTime @db.Timestamptz(3)
  /// up | down | range
  state     String   @db.VarChar(5)

  @@id([symbol, timeframe, at])
  @@map("market_trend_history")
}

/// Settled Binance funding rates (fraction per settlement), for Trade Check "your record".
model FundingRateHistory {
  symbol String   @db.VarChar(20)
  at     DateTime @db.Timestamptz(3)
  rate   Decimal  @db.Decimal(14, 10)

  @@id([symbol, at])
  @@map("funding_rate_history")
}

/// A market-moving headline (world, central banks, economy, crypto, markets), kept 30 days.
/// Reports of the same story from other sources point to the first one through cluster_id.
model NewsItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// FINNHUB | TRADINGECONOMICS | FED | ECB | GDELT
  source      String   @db.VarChar(20)
  sourceId    String   @map("source_id") @db.VarChar(200)
  title       String   @db.VarChar(500)
  summary     String?  @db.VarChar(2000)
  url         String?  @db.VarChar(1000)
  publisher   String   @db.VarChar(120)
  publishedAt DateTime @map("published_at") @db.Timestamptz(3)
  receivedAt  DateTime @map("received_at") @db.Timestamptz(3)
  /// world | central-banks | economy | crypto | markets
  category    String   @db.VarChar(20)
  /// HIGH | MEDIUM | LOW
  impact      String   @db.VarChar(6)
  tags        String[]
  why         String?  @db.VarChar(400)
  clusterId   String?  @map("cluster_id") @db.Uuid
  /// Price moves after a high-impact headline: { btc15m, btc60m, gold15m, gold60m } in %.
  reaction    Json?

  @@unique([source, sourceId])
  @@index([category, publishedAt(sort: Desc)])
  @@index([impact, publishedAt(sort: Desc)])
  @@index([clusterId])
  @@index([publishedAt])
  @@map("news_items")
}

/// A real forced close (liquidation) reported by an exchange's public feed.
model LiquidationEvent {
  id       BigInt   @id @default(autoincrement())
  exchange Exchange
  symbol   String   @db.VarChar(20)
  /// Liquidated position: long | short
  side     String   @db.VarChar(5)
  price    Decimal  @db.Decimal(24, 10)
  qty      Decimal  @db.Decimal(30, 10)
  usd      Decimal  @db.Decimal(20, 2)
  at       DateTime @db.Timestamptz(3)

  @@index([symbol, at(sort: Desc)])
  @@index([at])
  @@map("liquidation_events")
}

/// One crypto checkout (NOWPayments invoice). Crypto has no auto-renewal: each payment buys a
/// fixed period of a plan, added to any crypto time already paid.
model CryptoPayment {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  planCode    PlanCode  @map("plan_code")
  /// month | year
  interval    String    @db.VarChar(5)
  amountUsd   Decimal   @map("amount_usd") @db.Decimal(10, 2)
  invoiceId   String?   @unique @map("invoice_id") @db.VarChar(40)
  paymentId   String?   @map("payment_id") @db.VarChar(40)
  /// CREATED, WAITING, CONFIRMING, PAID, PARTIAL, FAILED, EXPIRED, REFUNDED
  status      String    @default("CREATED") @db.VarChar(12)
  payCurrency String?   @map("pay_currency") @db.VarChar(20)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)
  /// The plan's paid-until time after this payment was applied.
  periodEnd   DateTime? @map("period_end") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("crypto_payments")
}

model BillingEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Paddle event ID (evt_...).
  eventId    String   @unique @map("event_id")
  type       String
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  userId     String?  @map("user_id") @db.Uuid
  payload    Json
  /// What we did: APPLIED, IGNORED_STALE, IGNORED_UNKNOWN_USER, IGNORED_TYPE
  outcome    String   @db.VarChar(40)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("billing_events")
}

enum AnnouncementLevel {
  INFO
  WARNING
}

/// Message shown to all signed-in users between startsAt and endsAt.
model Announcement {
  id        String            @id @default(uuid(7)) @db.Uuid
  title     String            @db.VarChar(120)
  body      String            @db.VarChar(1000)
  level     AnnouncementLevel @default(INFO)
  startsAt  DateTime          @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime?         @map("ends_at") @db.Timestamptz(3)
  createdBy String?           @map("created_by") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([startsAt, endsAt])
  @@map("announcements")
}

/// Latest daily exchange rates, units of each currency per 1 USD. One row per currency, replaced on
/// each refresh; kept in the database so a provider outage still leaves the last good rates.
model FxRate {
  currency  String   @id @db.VarChar(3)
  perUsd    Decimal  @map("per_usd") @db.Decimal(24, 10)
  /// When the provider published these rates.
  asOf      DateTime @map("as_of") @db.Timestamptz(3)
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)
  source    String

  @@map("fx_rates")
}

/// Economic calendar events (CPI, rate decisions, speeches). Refreshed hourly from the source for
/// the current week and kept afterwards, so past weeks build up as history.
model EconomicEvent {
  /// Stable id from source + currency + title + scheduled time.
  id        String   @id @db.VarChar(64)
  title     String
  currency  String   @db.VarChar(8)
  /// HIGH | MEDIUM | LOW | NONE
  impact    String   @db.VarChar(8)
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  tentative Boolean  @default(false)
  actual    String?
  forecast  String?
  previous  String?
  /// Which source delivered the actual figure first (bls, tradingeconomics), and when.
  actualSource String?   @map("actual_source") @db.VarChar(32)
  actualAt     DateTime? @map("actual_at") @db.Timestamptz(3)
  source    String   @db.VarChar(32)
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)

  @@index([startsAt])
  @@map("economic_events")
}

// ─── My Setup Alerts ───

/// A trader's own setup: a validated JSON rule (data, never code) watched on candle close.
model Setup {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String    @db.VarChar(60)
  exchange        Exchange
  symbols         String[]
  timeframe       String    @db.VarChar(4)
  rule            Json
  ruleVersion     Int       @map("rule_version") @db.SmallInt
  cooldownMinutes Int       @default(60) @map("cooldown_minutes")
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts    SetupAlert[]
  paperBots PaperBot[]
  backtests BacktestRun[]

  @@index([userId, createdAt])
  /// The scanner groups active setups by exchange and timeframe.
  @@index([isActive, exchange, timeframe])
  @@map("setups")
}

model SetupAlert {
  id            String    @id @default(uuid(7)) @db.Uuid
  setupId       String    @map("setup_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  symbol        String    @db.VarChar(30)
  timeframe     String    @db.VarChar(4)
  /// long | short
  direction     String    @db.VarChar(5)
  candleCloseAt DateTime  @map("candle_close_at") @db.Timestamptz(3)
  /// Plain-language conditions that matched.
  matched       Json
  channels      String[]
  dismissedAt   DateTime? @map("dismissed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  setup     Setup      @relation(fields: [setupId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions Position[]

  /// At most one alert per setup, symbol and candle, even when two scanners race.
  @@unique([setupId, symbol, candleCloseAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, symbol, candleCloseAt])
  @@map("setup_alerts")
}

// ─── Labs ───

model WhatIfScenario {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(60)
  filters   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("what_if_scenarios")
}

model BacktestRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  setupId    String?   @map("setup_id") @db.Uuid
  /// Copied at start, so later edits or deletion of the setup never change old results.
  setupName  String    @map("setup_name") @db.VarChar(60)
  rule       Json
  exchange   Exchange
  timeframe  String    @db.VarChar(4)
  symbols    String[]
  exitModel  Json      @map("exit_model")
  fromDay    DateTime  @map("from_day") @db.Date
  toDay      DateTime  @map("to_day") @db.Date
  /// QUEUED | RUNNING | DONE | FAILED
  status     String    @default("QUEUED") @db.VarChar(10)
  progress   Float     @default(0) @db.Real
  summary    Json?
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt  DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  setup  Setup?          @relation(fields: [setupId], references: [id], onDelete: SetNull)
  trades BacktestTrade[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("backtest_runs")
}

/// Simulated trades (market data, not money owed: floating point is fine here).
model BacktestTrade {
  id         String            @id @default(uuid(7)) @db.Uuid
  runId      String            @map("run_id") @db.Uuid
  symbol     String            @db.VarChar(30)
  side       PositionDirection
  entryAt    DateTime          @map("entry_at") @db.Timestamptz(3)
  entryPrice Float             @map("entry_price")
  exitAt     DateTime          @map("exit_at") @db.Timestamptz(3)
  exitPrice  Float             @map("exit_price")
  /// STOP | TARGET | TIME | END
  exitReason String            @map("exit_reason") @db.VarChar(8)
  rMultiple  Float             @map("r_multiple")
  pnl        Float
  fees       Float
  funding    Float
  flags      String[]

  run BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, entryAt])
  @@map("backtest_trades")
}

// ─── Market data (public exchange data, shared by every user) ───

model MarketCandle {
  exchange  Exchange
  symbol    String   @db.VarChar(30)
  timeframe String   @db.VarChar(4)
  openTime  DateTime @map("open_time") @db.Timestamptz(3)
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float

  @@id([exchange, symbol, timeframe, openTime])
  @@map("market_candles")
}

model FundingRate {
  exchange    Exchange
  symbol      String   @db.VarChar(30)
  fundingTime DateTime @map("funding_time") @db.Timestamptz(3)
  rate        Float

  @@id([exchange, symbol, fundingTime])
  @@map("funding_rates")
}

/// Market Pulse: latest correlation and beta to BTC per coin and window.
model MarketCorrelation {
  symbol      String   @db.VarChar(30)
  window      String   @db.VarChar(4)
  rank        Int
  quoteVolume Decimal  @map("quote_volume") @db.Decimal(24, 2)
  corr        Float
  beta        Float
  relStrength Float    @map("rel_strength")
  coinReturn  Float    @map("coin_return")
  btcReturn   Float    @map("btc_return")
  points      Int
  computedAt  DateTime @map("computed_at") @db.Timestamptz(3)

  @@id([symbol, window])
  @@index([window, rank])
  @@map("market_correlation_latest")
}

/// Hourly 24h correlation per coin (kept 120 days): history charts and correlation at trade entry.
model MarketCorrelationHourly {
  symbol String   @db.VarChar(30)
  hour   DateTime @db.Timestamptz(3)
  corr   Float
  beta   Float

  @@id([symbol, hour])
  @@index([hour])
  @@map("market_correlation_hourly")
}

/// Estimated liquidation map per market and window, recomputed by the worker every 5 minutes.
/// `data` holds the encoded heatmap and clusters (LiquidationMapDto without symbol/window).
model LiquidationMap {
  symbol     String   @db.VarChar(30)
  window     String   @db.VarChar(4)
  data       Json
  computedAt DateTime @map("computed_at") @db.Timestamptz(3)

  @@id([symbol, window])
  @@map("liquidation_maps")
}

/// Latest market-wide readings (CoinMarketCap global metrics, Fear & Greed, Altcoin Season Index).
model MarketSnapshot {
  key       String   @id @db.VarChar(40)
  data      Json
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("market_snapshots")
}

/// Total crypto market cap over time, for the dashboard mini chart (kept ~35 days).
model MarketCapPoint {
  ts             DateTime @id @db.Timestamptz(3)
  totalMarketCap Decimal  @map("total_market_cap") @db.Decimal(30, 2)

  @@map("market_cap_points")
}

/// "Tell me when this market has N readings one way" alerts (Scalp Cockpit).
model ScalpAlert {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  symbol      String    @db.VarChar(30)
  /// 5m | 15m
  tf          String    @db.VarChar(4)
  /// ANY | UP | DOWN
  direction   String    @db.VarChar(4)
  minCount    Int       @map("min_count") @db.SmallInt
  noNews      Boolean   @default(true) @map("no_news")
  enabled     Boolean   @default(true)
  cooldownMin Int       @default(30) @map("cooldown_min") @db.SmallInt
  /// Whether the condition held at the last check (alerts fire when it starts holding).
  lastMet     Boolean   @default(false) @map("last_met")
  lastFiredAt DateTime? @map("last_fired_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// One-tap trade plan sent with the alert: stop in typical 5-minute ranges, target in R, and
  /// the money to risk (null = no size).
  planStopRanges Float    @default(1.5) @map("plan_stop_ranges") @db.Real
  planTargetR    Float    @default(2) @map("plan_target_r") @db.Real
  planRiskUsd    Decimal? @map("plan_risk_usd") @db.Decimal(14, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@map("scalp_alerts")
}

/// A paper-trading bot: virtual money, live market data, the trader's own rules. Never sends orders.
model PaperBot {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(60)
  symbol       String   @db.VarChar(30)
  /// COCKPIT (count of Cockpit readings, live) | SETUP (a saved setup, on candle close)
  source       String   @db.VarChar(8)
  /// Cockpit: 5m | 15m. Setup: the setup's timeframe.
  tf           String   @db.VarChar(4)
  setupId      String?  @map("setup_id") @db.Uuid
  /// Cockpit bots: ANY | UP | DOWN, readings needed, quiet around news.
  direction    String   @default("ANY") @db.VarChar(4)
  minCount     Int      @default(7) @map("min_count") @db.SmallInt
  noNews       Boolean  @default(true) @map("no_news")
  /// Exits: stop in typical ranges of the timeframe, target in R, longest hold.
  stopRanges   Float    @default(1.5) @map("stop_ranges") @db.Real
  targetR      Float    @default(2) @map("target_r") @db.Real
  maxHoldMin   Int      @default(60) @map("max_hold_min")
  /// Sizing and costs: share of equity risked, taker fee and slippage per fill (basis points).
  riskPct      Float    @default(1) @map("risk_pct") @db.Real
  feeBps       Float    @default(5) @map("fee_bps") @db.Real
  slippageBps  Float    @default(2) @map("slippage_bps") @db.Real
  startEquity  Float    @default(10000) @map("start_equity")
  equity       Float    @default(10000)
  enabled      Boolean  @default(true)
  /// Whether the entry rule held at the last check (a bot enters when it starts holding).
  lastMet      Boolean  @default(false) @map("last_met")
  /// When the current run started (reset clears the trades and starts again).
  startedAt    DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  setup  Setup?       @relation(fields: [setupId], references: [id], onDelete: SetNull)
  trades PaperTrade[]

  @@index([userId])
  @@index([enabled])
  @@map("paper_bots")
}

/// One virtual trade of a paper bot.
model PaperTrade {
  id          String            @id @default(uuid(7)) @db.Uuid
  botId       String            @map("bot_id") @db.Uuid
  symbol      String            @db.VarChar(30)
  side        PositionDirection
  entryAt     DateTime          @map("entry_at") @db.Timestamptz(3)
  entryPrice  Float             @map("entry_price")
  stop        Float
  target      Float
  qty         Float
  riskUsd     Float             @map("risk_usd")
  /// The Cockpit count when it entered ({ up, down, total }), or the setup's conditions.
  entryNote   Json?             @map("entry_note")
  exitAt      DateTime?         @map("exit_at") @db.Timestamptz(3)
  exitPrice   Float?            @map("exit_price")
  /// STOP | TARGET | TIME | MANUAL
  exitReason  String?           @map("exit_reason") @db.VarChar(8)
  fees        Float             @default(0)
  funding     Float             @default(0)
  pnl         Float?
  rMultiple   Float?            @map("r_multiple")
  /// Last funding time already charged (00:00, 08:00, 16:00 UTC).
  fundedUntil DateTime?         @map("funded_until") @db.Timestamptz(3)
  /// OPEN | CLOSED
  status      String            @default("OPEN") @db.VarChar(6)

  bot PaperBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, entryAt])
  @@index([status])
  @@map("paper_trades")
}

/// Every market's Scalp Cockpit counts and buy pressure, one row per minute (kept 8 days): stamps
/// trades at entry and feeds the threshold review.
model ScalpReadout {
  at   DateTime @id @db.Timestamptz(3)
  /// { SYMBOL: [up5, down5, total5, up15, down15, total15, p5m, p15m, p30m, p1h, price] }
  data Json

  @@map("scalp_readouts")
}

/// "Tell me when Gold reaches a fresh 4H demand zone": checked every second on the live price.
model ZoneAlert {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  symbol      String    @db.VarChar(30)
  /// Zone timeframes watched: 1h, 4h.
  tfs         String[]
  /// ANY | SUPPLY | DEMAND
  side        String    @default("ANY") @db.VarChar(6)
  freshOnly   Boolean   @default(true) @map("fresh_only")
  /// The same zone does not alert again within this many minutes.
  cooldownMin Int       @default(120) @map("cooldown_min") @db.SmallInt
  enabled     Boolean   @default(true)
  /// The zone of the last alert ("4h:demand:<start ms>") and when it was sent.
  lastZoneKey String?   @map("last_zone_key") @db.VarChar(60)
  lastFiredAt DateTime? @map("last_fired_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@map("zone_alerts")
}

/// Each market's standing supply/demand zones per timeframe, recorded when a candle closes
/// (kept 8 days, for stamping trades with the zone they were entered at).
model ZoneHistory {
  symbol String   @db.VarChar(30)
  tf     String   @db.VarChar(4)
  /// Close time of the newest candle the zones were found on.
  at     DateTime @db.Timestamptz(3)
  /// [{ side, top, bottom, t, tests }]
  zones  Json

  @@id([symbol, tf, at])
  @@index([at])
  @@map("zone_history")
}
